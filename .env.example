# Backend Environment Variables
# Copy this file to .env for local development

# Flask Configuration
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000

# CORS - Set to your frontend URL in production
# Example: CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=*

# Content Limits
MAX_CONTENT_LENGTH_BYTES=2097152

# Python Engine Limits
PY_MAX_CODE_LENGTH=20000
PY_MAX_STEPS=15000
PY_TIMEOUT_SECONDS=6
PY_MAX_OUTPUT_CHARS=200000
PY_MAX_MEMORY_MB=256
PY_MAX_USER_INPUTS=200

# C++ Engine Limits
CPP_MAX_CODE_LENGTH=20000
CPP_MAX_STEPS=4000
CPP_COMPILE_TIMEOUT_SECONDS=10
CPP_RUN_TIMEOUT_SECONDS=8
CPP_MAX_OUTPUT_CHARS=200000
CPP_MAX_MEMORY_MB=256
GXX_PATH=g++
GDB_PATH=gdb

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
