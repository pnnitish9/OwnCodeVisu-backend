# Copy this file to .env and adjust as needed.
CODEVIZ_ENVIRONMENT=development
CODEVIZ_CORS_ORIGINS=["http://localhost:5173"]
CODEVIZ_DATABASE_URL=postgresql+asyncpg://codeviz:codeviz@localhost:5432/codeviz
CODEVIZ_REDIS_URL=redis://localhost:6379/0
# Flask
FLASK_ENV=production
HOST=0.0.0.0
PORT=5000

# Comma-separated list of origins allowed to call the API.
# Use "*" only for local development.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Execution limits (Python engine)
PY_MAX_CODE_LENGTH=20000
PY_MAX_STEPS=15000
PY_TIMEOUT_SECONDS=6
PY_MAX_OUTPUT_CHARS=200000
PY_MAX_MEMORY_MB=256

# Execution limits (C++ engine)
CPP_MAX_CODE_LENGTH=20000
CPP_MAX_STEPS=4000
CPP_COMPILE_TIMEOUT_SECONDS=10
CPP_RUN_TIMEOUT_SECONDS=8
CPP_MAX_OUTPUT_CHARS=200000
CPP_MAX_MEMORY_MB=256
GXX_PATH=g++
GDB_PATH=gdb

# Simple in-memory rate limiter
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
